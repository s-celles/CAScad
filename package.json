{
  "name": "cascad",
  "version": "0.1.3",
  "description": "A reactive notebook for symbolic computation (computer algebra system) running entirely in the browser",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/s-celles/CAScad.git"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "serve": "bun run scripts/serve.ts",
    "dev": "bun run scripts/build.ts && bun run scripts/serve.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2",
    "yjs": "13.6.33"
  },
  "dependencies": {
    "lean-qr": "2.7.4",
    "marked": "18.0.7"
  }
}
